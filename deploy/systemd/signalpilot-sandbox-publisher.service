[Unit]
Description=SignalPilot sandbox research SQS publisher (no trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/signalpilot
Environment=SIGNALPILOT_SANDBOX_PUBLISH_ENABLED=1
ExecStart=/usr/bin/flock -n /run/lock/signalpilot-sandbox-publisher.lock /opt/signalpilot/.venv/bin/python -m futures_engine.sandbox_research_publisher
TimeoutStartSec=45
NoNewPrivileges=true
