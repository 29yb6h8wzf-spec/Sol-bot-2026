[Unit]
Description=SignalPilot Binance Futures research Telegram bridge (owner-only, no trading)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/signalpilot/binance-research-bridge-secret
ConditionPathExists=/etc/signalpilot/binance-research-bridge.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/signalpilot
EnvironmentFile=/etc/signalpilot/binance-research-bridge.env
ExecStart=/opt/signalpilot/.venv/bin/python /opt/signalpilot/binance_telegram_bridge.py
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=45
