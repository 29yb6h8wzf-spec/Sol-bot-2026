{
  "schema_version": "signals_v2.research_manifest.1",
  "status": "DESIGN_ONLY",
  "scope": {
    "symbols": [
      "SOLUSDT",
      "XRPUSDT"
    ],
    "directions": [
      "LONG",
      "SHORT"
    ],
    "scan_seconds": 300,
    "primary_timeframe": "5m",
    "confirmation_timeframe": "1m",
    "max_holding_minutes": 240,
    "signal_validity_bars_5m": [
      1,
      2
    ],
    "free_data_only": true,
    "hybrid_engine": true,
    "per_symbol_calibration": true,
    "market_regimes": [
      "TREND",
      "RANGE_COMPRESSION",
      "BREAKOUT_TRANSITION",
      "HIGH_VOLATILITY",
      "UNKNOWN"
    ],
    "range_policy": "WAIT_FOR_BREAKOUT",
    "high_volatility_policy": "CONSIDER_WITH_LIQUIDITY_AND_COST_VETO",
    "no_daily_signal_quota": true
  },
  "non_execution": {
    "research_only": true,
    "execution_authorized": false,
    "orders_sent": false,
    "change_existing_scanner": false,
    "change_demo_verifier": false,
    "change_order_planner": false,
    "change_risk_limits": false,
    "change_systemd": false,
    "change_telegram_production": false,
    "merge_or_deploy": false
  },
  "specialists": [
    {
      "id": "trend_continuation",
      "features": [
        "structure",
        "ema_variants",
        "adx",
        "momentum",
        "relative_volume"
      ],
      "test": [
        "rules_baseline",
        "single_family_ablation",
        "full"
      ]
    },
    {
      "id": "breakout_expansion",
      "features": [
        "compression",
        "range_break",
        "volume",
        "retest",
        "sweep_optional"
      ],
      "test": [
        "rules_baseline",
        "single_family_ablation",
        "full"
      ]
    },
    {
      "id": "liquidity_reversal",
      "features": [
        "liquidity_sweep",
        "choch",
        "fvg",
        "order_blocks",
        "atr"
      ],
      "test": [
        "rules_baseline",
        "single_family_ablation",
        "full"
      ]
    }
  ],
  "experimental_features": {
    "indicators": [
      "EMA_9_21",
      "EMA_20_50",
      "ADX_14",
      "RSI_14",
      "MACD",
      "VWAP_ENTRY_EXIT",
      "OBV",
      "MFI",
      "ROC",
      "ATR_14"
    ],
    "futures": [
      "OPEN_INTEREST",
      "FUNDING_RATE",
      "LIQUIDATIONS",
      "TRADE_DELTA",
      "CVD",
      "ORDERBOOK_IMBALANCE"
    ],
    "market_structure": [
      "BOS",
      "CHoCH",
      "SUPPORT_RESISTANCE",
      "FVG",
      "ORDER_BLOCK",
      "LIQUIDITY_SWEEP"
